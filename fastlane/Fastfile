default_platform(:ios)

platform :ios do
  desc "Build and upload PULSE Insight to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_ISSUER_ID"),
      key_content: ENV.fetch("APPLE_KEY_CONTENT"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: "com.digitalaimgroup.pulseinsight",
      team_id: "MBVD3UJLM2",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: false
    )

    build_number = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "MBVD3UJLM2",
      targets: ["App"],
      bundle_identifier: "com.digitalaimgroup.pulseinsight",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_com.digitalaimgroup.pulseinsight_appstore_profile-name"],
      profile_uuid: ENV["sigh_com.digitalaimgroup.pulseinsight_appstore"]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "MBVD3UJLM2",
        provisioningProfiles: {
          "com.digitalaimgroup.pulseinsight" => ENV["sigh_com.digitalaimgroup.pulseinsight_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "PULSE Insight iOS TestFlight build #{build_number}"
    )
  end
end
